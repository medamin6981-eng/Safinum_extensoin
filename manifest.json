{
"manifest_version": 3,
"name": "Safinum Pay - Traducteur Haoussa",
"version": "1.0.0",
"description": "Traduction dynamique en langue Haoussa pour les services financiers Safinum Pay.",
"permissions": [
"storage",
"activeTab",
"scripting"
],
"host_permissions": [
"https://api.mymemory.translated.net/*"
],
"background": {
"service_worker": "background.js"
},
"action": {
"default_popup": "popup.html"
},
"content_scripts": [
{
"matches": ["<all_urls>"],
"js": ["dictionary.js", "content.js"],
"run_at": "document_idle"
}
]
}