{
  "manifest_version": 3,
  "name": "Safinum Pay - Traducteur Haoussa",
  "version": "1.1.0",
  "description": "Rend les services financiers numériques compréhensibles en haoussa, sans modifier leur code source.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://api.mymemory.translated.net/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Safinum Haoussa"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "dictionary.js",
        "translator.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}